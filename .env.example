# TILLY 백엔드 로컬 환경변수 예시 (값은 비워 둠 — 실제 값은 .env에만 작성, .env는 git 제외)
# 이 파일을 복사해 .env로 만들고 값을 채우세요: cp .env.example .env

# MySQL 접속 정보 (NOTICE-014) — docker-compose의 mysql 서비스와 짝이 맞아야 함
# DB_URL 형식 예시: jdbc:mysql://localhost:3306/tilly?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Seoul
DB_URL=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Redis 접속 정보 (NOTICE-032) — docker-compose의 redis 서비스와 짝이 맞아야 함
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# 서버 (선택, 비우면 8080)
SERVER_PORT=

# Gemini (NOTICE-016) — 무료 모델만 사용. 키는 이 파일이 아니라 .env에만 입력
# GEMINI_BASE_URL: 공식 문서의 호스트만 입력 (경로는 코드가 붙임)
# GEMINI_MODEL: 사용할 모델 이름 하나 / GEMINI_ALLOWED_MODELS: 무료임을 확인한 모델 이름들(쉼표 구분)
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
GEMINI_ALLOWED_MODELS=
